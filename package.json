{
  "name": "@airbee-project/spatial-id",
  "version": "0.10.1",
  "description": "spatial-id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AirBee-Project/spatial-id-ts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "bun@1.3.11",
  "exports": {
    "./spatial-id": {
      "spatial-id-source": "./src/spatial-id/index.ts",
      "import": {
        "types": "./dist/spatial-id/index.d.ts",
        "default": "./dist/spatial-id/index.js"
      },
      "require": {
        "types": "./dist/cjs/spatial-id/index.d.ts",
        "default": "./dist/spatial-id/index.cjs"
      }
    },
    "./time": {
      "spatial-id-source": "./src/time/index.ts",
      "import": {
        "types": "./dist/time/index.d.ts",
        "default": "./dist/time/index.js"
      },
      "require": {
        "types": "./dist/cjs/time/index.d.ts",
        "default": "./dist/time/index.cjs"
      }
    },
    "./geometry": {
      "spatial-id-source": "./src/geometry/index.ts",
      "import": {
        "types": "./dist/geometry/index.d.ts",
        "default": "./dist/geometry/index.js"
      },
      "require": {
        "types": "./dist/cjs/geometry/index.d.ts",
        "default": "./dist/geometry/index.cjs"
      }
    },
    "./collection": {
      "spatial-id-source": "./src/collection/index.ts",
      "import": {
        "types": "./dist/collection/index.d.ts",
        "default": "./dist/collection/index.js"
      },
      "require": {
        "types": "./dist/cjs/collection/index.d.ts",
        "default": "./dist/collection/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "spatial-id": [
        "./dist/spatial-id/index.d.ts"
      ],
      "time": [
        "./dist/time/index.d.ts"
      ],
      "geometry": [
        "./dist/geometry/index.d.ts"
      ],
      "collection": [
        "./dist/collection/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "!src/collection/wasm/gen",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config scripts/tsup.config.ts",
    "clean": "rm -rf dist docs coverage wasm/*/target node_modules",
    "dev": "bun --conditions spatial-id-source playground/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --write .",
    "fmt": "biome format --write .",
    "check": "tsc --noEmit && biome check .",
    "ci": "tsc --noEmit && biome check . && bun run docs:check && bun run test",
    "test": "bun test --conditions spatial-id-source",
    "test:watch": "bun test --conditions spatial-id-source --watch",
    "generate": "bun scripts/generate.ts",
    "docs": "bun scripts/docs-serve.ts",
    "docs:build": "typedoc --options scripts/typedoc.json",
    "docs:check": "typedoc --options scripts/typedoc.json --emit none --treatWarningsAsErrors"
  },
  "keywords": [],
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "browser-sync": "^3.0.4",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.0",
    "vitest": "^5.0.0"
  }
}
